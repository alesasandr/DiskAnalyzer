<Window x:Class="DiskAnalyzer.WPF.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DiskAnalyzer.Core.Models;assembly=DiskAnalyzer.Core"
        Title="Settings"
        Width="420" Height="360"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Scan Settings" FontWeight="Bold" FontSize="14"
                       Foreground="{StaticResource AccentBlue}" Margin="0,0,0,8"/>

            <CheckBox Content="Skip system folders ($Recycle.Bin, etc.)"
                      IsChecked="{Binding SkipSystemFolders}" Margin="0,0,0,8"/>

            <CheckBox Content="Skip hidden files"
                      IsChecked="{Binding SkipHiddenFiles}" Margin="0,0,0,8"/>

            <CheckBox Content="Show file extension statistics"
                      IsChecked="{Binding ShowFileExtensionStats}" Margin="0,0,0,8"/>

            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Max scan depth (0 = unlimited):" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding MaxDepthLimit, UpdateSourceTrigger=PropertyChanged}"
                         HorizontalAlignment="Stretch"/>
            </Grid>

            <Separator Margin="0,4"/>

            <TextBlock Text="Appearance" FontWeight="Bold" FontSize="14"
                       Foreground="{StaticResource AccentBlue}" Margin="0,0,0,4"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Theme:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding Theme}"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Default sort:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding SortModes}"
                          SelectedItem="{Binding DefaultSortMode}"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Reset Defaults" Command="{Binding ResetCommand}" Padding="10,5" Margin="0,0,8,0"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="10,5" Margin="0,0,8,0"/>
            <Button Content="Save" Command="{Binding SaveCommand}"
                    Style="{StaticResource AccentButton}" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>
