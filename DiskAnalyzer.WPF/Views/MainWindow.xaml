<Window x:Class="DiskAnalyzer.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DiskAnalyzer.Core.Models;assembly=DiskAnalyzer.Core"
        xmlns:vm="clr-namespace:DiskAnalyzer.WPF.ViewModels"
        Title="Disk Analyzer"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelScanCommand}"/>
        <KeyBinding Key="Back" Command="{Binding NavigateUpCommand}"/>
        <KeyBinding Key="F2" Command="{Binding BrowseFolderCommand}"/>
        <KeyBinding Key="F1" Command="{Binding ShowHelpCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportCsvCommand}"/>
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding ExportTextCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding OpenSettingsCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <!-- TOP BAR -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Margin="0,0,6,0"
                          ItemsSource="{Binding AvailableDrives}"
                          SelectedItem="{Binding SelectedDrive}"
                          DisplayMemberPath="DisplayName"
                          VerticalAlignment="Center"/>

                <TextBox Grid.Column="1" Margin="0,0,6,0"
                         Text="{Binding ScanPath, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"/>

                <Button Grid.Column="2" Content="Browse..." Margin="0,0,6,0"
                        Command="{Binding BrowseFolderCommand}" VerticalAlignment="Center"/>

                <Button Grid.Column="3" Content="▶ Scan (F5)" Margin="0,0,6,0"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding ScanCommand}" VerticalAlignment="Center"/>

                <Button Grid.Column="4" Content="✕ Cancel" Margin="0,0,6,0"
                        Command="{Binding CancelScanCommand}" VerticalAlignment="Center"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>

                <Button Grid.Column="5" Content="↺ Refresh" Margin="0,0,6,0"
                        Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>

                <Button Grid.Column="6" Content="⚙ Settings" Margin="0,0,6,0"
                        Command="{Binding OpenSettingsCommand}" VerticalAlignment="Center"/>

                <Button Grid.Column="7" Content="? Help"
                        Command="{Binding ShowHelpCommand}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- DRIVE INFO BAR -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock Text="Drive: " Foreground="{StaticResource ForegroundSecondary}"/>
                    <TextBlock Text="{Binding SelectedDrive.Name}" FontWeight="SemiBold" Margin="0,0,16,0"/>
                    <TextBlock Text="Used: " Foreground="{StaticResource ForegroundSecondary}"/>
                    <TextBlock Text="{Binding DriveUsedFormatted}" Margin="0,0,4,0"/>
                    <TextBlock Text="/" Foreground="{StaticResource ForegroundMuted}" Margin="0,0,4,0"/>
                    <TextBlock Text="{Binding DriveTotalFormatted}" Margin="0,0,16,0"/>
                    <TextBlock Text="Free: " Foreground="{StaticResource ForegroundSecondary}"/>
                    <TextBlock Text="{Binding DriveFreeFormatted}" Foreground="{StaticResource AccentGreen}"/>
                </StackPanel>
                <ProgressBar Grid.Row="2" Height="12" Minimum="0" Maximum="100"
                             Value="{Binding DriveUsedPercent, Mode=OneWay}"/>
            </Grid>
        </Border>

        <!-- BREADCRUMB BAR -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:BreadcrumbItem}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Name}"
                                    Command="{Binding DataContext.NavigateToBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    BorderThickness="0" Background="Transparent"
                                    Foreground="{StaticResource AccentBlue}"
                                    Cursor="Hand" Padding="2,0"/>
                            <TextBlock Text=" › " Foreground="{StaticResource ForegroundMuted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- STATUS BAR (bottom) -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar Width="120" Height="6" IsIndeterminate="True"
                             Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- MAIN CONTENT -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="5"/>
                <RowDefinition Height="200" MinHeight="120"/>
            </Grid.RowDefinitions>

            <!-- Upper: TreeView + DataGrid -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" MinWidth="150"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: TreeView -->
                <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <TreeView x:Name="FolderTree" ItemsSource="{Binding RootNode, Converter={x:Null}}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:FolderNode}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="{Binding Converter={StaticResource NodeToIcon}}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                               Foreground="{StaticResource FolderColor}"/>
                                    <TextBlock Text=" " />
                                    <TextBlock Text="{Binding FormattedSize}"
                                               Foreground="{StaticResource ForegroundSecondary}"
                                               FontSize="11"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>

                <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                              Background="{StaticResource BorderBrush}"/>

                <!-- RIGHT: DataGrid -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Sort bar -->
                    <Border Grid.Row="0" Background="{StaticResource SurfaceBackground}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="6,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sort: " Foreground="{StaticResource ForegroundSecondary}" VerticalAlignment="Center"/>
                            <Button Content="Size ↓" Margin="4,0" Padding="6,2"
                                    Command="{Binding SortCommand}" CommandParameter="{x:Static models:SortMode.BySizeDescending}"/>
                            <Button Content="Size ↑" Margin="4,0" Padding="6,2"
                                    Command="{Binding SortCommand}" CommandParameter="{x:Static models:SortMode.BySizeAscending}"/>
                            <Button Content="Name A-Z" Margin="4,0" Padding="6,2"
                                    Command="{Binding SortCommand}" CommandParameter="{x:Static models:SortMode.ByNameAscending}"/>
                            <Button Content="Name Z-A" Margin="4,0" Padding="6,2"
                                    Command="{Binding SortCommand}" CommandParameter="{x:Static models:SortMode.ByNameDescending}"/>
                            <Button Content="Files ↓" Margin="4,0" Padding="6,2"
                                    Command="{Binding SortCommand}" CommandParameter="{x:Static models:SortMode.ByFileCountDescending}"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="ContentGrid"
                              ItemsSource="{Binding CurrentLevelItems}"
                              SelectedItem="{Binding SelectedNode}"
                              MouseDoubleClick="ContentGrid_MouseDoubleClick">
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open in Explorer" Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                <MenuItem Header="Copy Path" Command="{Binding DataContext.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Width="30"
                                Binding="{Binding Converter={StaticResource NodeToIcon}}"
                                IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name" Width="*"
                                Binding="{Binding Name}" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="{Binding Converter={StaticResource FolderBold}}"/>
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Size" Width="90"
                                Binding="{Binding FormattedSize}" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundPrimary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="% of Parent" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Minimum="0" Maximum="100"
                                                         Value="{Binding PercentOfParent, Mode=OneWay}"
                                                         Height="14" Margin="2"/>
                                            <TextBlock Text="{Binding PercentOfParent, StringFormat={}{0:F1}%}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="10" Foreground="{StaticResource ForegroundPrimary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="% of Total" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Minimum="0" Maximum="100"
                                                         Value="{Binding PercentOfRoot, Mode=OneWay}"
                                                         Height="14" Margin="2"/>
                                            <TextBlock Text="{Binding PercentOfRoot, StringFormat={}{0:F1}%}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="10" Foreground="{StaticResource ForegroundPrimary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Files" Width="70"
                                IsReadOnly="True">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="FileCount"/>
                                </DataGridTextColumn.Binding>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundSecondary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Modified" Width="130"
                                Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundSecondary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrush}"/>

            <!-- BOTTOM TABS -->
            <TabControl Grid.Row="2">
                <TabItem Header="Extension Stats">
                    <DataGrid ItemsSource="{Binding ExtensionStats}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Extension" Width="100" Binding="{Binding Extension}"/>
                            <DataGridTextColumn Header="Files" Width="70" Binding="{Binding FileCount}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Total Size" Width="100" Binding="{Binding FormattedSize}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="% of Total" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <ProgressBar Minimum="0" Maximum="100"
                                                         Value="{Binding PercentOfRoot, Mode=OneWay}"
                                                         Height="14" Margin="2"/>
                                            <TextBlock Text="{Binding PercentOfRoot, StringFormat={}{0:F1}%}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="10" Foreground="{StaticResource ForegroundPrimary}"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Top 50 Largest Files">
                    <DataGrid ItemsSource="{Binding TopFiles}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File Name" Width="200" Binding="{Binding Name}"/>
                            <DataGridTextColumn Header="Full Path" Width="*" Binding="{Binding FullPath}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundSecondary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Size" Width="90" Binding="{Binding FormattedSize}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Modified" Width="130"
                                Binding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource ForegroundSecondary}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
