<Window x:Class="DiskAnalyzer.WPF.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help — Keyboard Shortcuts"
        Width="480" Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Keyboard Shortcuts" FontSize="16" FontWeight="Bold"
                   Foreground="{StaticResource AccentBlue}" Margin="0,0,0,12"/>

        <DataGrid Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserSortColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Shortcut" Width="120" Binding="{Binding Key}">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="{StaticResource AccentYellow}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Action" Width="*" Binding="{Binding Action}"/>
            </DataGrid.Columns>
            <DataGrid.Items>
                <x:Array Type="local:ShortcutEntry"
                         xmlns:local="clr-namespace:DiskAnalyzer.WPF.Views">
                    <local:ShortcutEntry Key="F5" Action="Start scan / Refresh"/>
                    <local:ShortcutEntry Key="Escape" Action="Cancel ongoing scan"/>
                    <local:ShortcutEntry Key="Backspace" Action="Navigate up to parent folder"/>
                    <local:ShortcutEntry Key="Enter" Action="Navigate into selected folder"/>
                    <local:ShortcutEntry Key="F2" Action="Browse for folder"/>
                    <local:ShortcutEntry Key="F1" Action="Show this help window"/>
                    <local:ShortcutEntry Key="Ctrl+E" Action="Export to CSV"/>
                    <local:ShortcutEntry Key="Ctrl+T" Action="Export to text file"/>
                    <local:ShortcutEntry Key="Ctrl+," Action="Open settings"/>
                </x:Array>
            </DataGrid.Items>
        </DataGrid>

        <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0"
                Padding="16,6" Click="CloseButton_Click"/>
    </Grid>
</Window>
